# Local source archives are user-provided and are never part of the application.
datasets/

# Reproducible generated data, model weights, and run outputs.
data/glasseye_v1/
data/external/
data/bfdd_binary_v1/
data/bfdd_cubit_binary_v1/
data/bfdd_cubit_uav2k_binary_v1/
models/*
!models/.gitkeep
# Checkpoints (6 MB each) ship with the repo so builds and deploys skip retraining
!models/glasseye-yolo-v1/
!models/glasseye-yolo-v1/best.pt
!models/glasseye-yolo-v1/model_manifest.json
models/glasseye-yolo-v1/training_runs/
!models/glasseye-yolo-bfdd-cubit-v1/
!models/glasseye-yolo-bfdd-cubit-v1/best.pt
!models/glasseye-yolo-bfdd-cubit-v1/model_manifest.json
!models/glasseye-yolo-bfdd-cubit-v1/metrics_report.json
models/glasseye-yolo-bfdd-cubit-v1/training_runs/
artifacts/*
!artifacts/.gitkeep
!artifacts/samples/
!artifacts/samples/*

# Environments and tooling output.
.venv/
backend/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ultralytics/
.matplotlib/
.mypy_cache/
coverage.xml
htmlcov/
frontend/node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
frontend/tests/demo/recordings/
backend/*.egg-info/
yolo*.pt
*.log
.DS_Store
